# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Qdrant file-store mode by default. Set QDRANT_URL to use a server.
QDRANT_PATH=./qdrant_data
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Embedding and reranking
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
BGE_USE_FP16=1

# Source paths
SELENIUM_REPO_DIR=./data/selenium_repo
PLAYWRIGHT_REPO_DIR=./data/playwright_repo
TESTCASES_CSV=./data/csv/testcases_vwo_100.csv
PDFS_DIR=./data/pdf
JIRA_MD_DIR=./data/md

# Retrieval knobs
TOP_K_PER_COLLECTION=12
RERANK_TOP_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
HISTORY_TURNS=4
INGEST_BATCH=16

# Scheduler
INGEST_INTERVAL_MINUTES=60
INGEST_AT_STARTUP=true
INGEST_TARGETS=selenium,playwright,testcases,pdfs,jira
INGEST_RECREATE=false
INGEST_LOCK_FILE=./data/.ingest.lock

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Qdrant: Set these for Qdrant Cloud (Required for Vercel)
QDRANT_URL=
QDRANT_API_KEY=

# Embedding and reranking (Using OpenAI for Vercel compatibility)
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small
RERANK_MODEL=overlap-fallback

# Source paths
SELENIUM_REPO_DIR=./data/selenium_repo
PLAYWRIGHT_REPO_DIR=./data/playwright_repo
TESTCASES_CSV=./data/csv/testcases_vwo_100.csv
PDFS_DIR=./data/pdf
JIRA_MD_DIR=./data/md

# Retrieval knobs
TOP_K_PER_COLLECTION=12
RERANK_TOP_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
HISTORY_TURNS=4
INGEST_BATCH=16

# Scheduler
INGEST_INTERVAL_MINUTES=60
INGEST_AT_STARTUP=true
INGEST_TARGETS=selenium,playwright,testcases,pdfs,jira
INGEST_RECREATE=false
INGEST_LOCK_FILE=./data/.ingest.lock
